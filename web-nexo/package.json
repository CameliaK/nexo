{
  "name": "nexo-constelacion",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4175 --strictPort",
    "test": "node scripts/test.mjs",
    "perf": "node scripts/performance.mjs",
    "test:browser": "node scripts/chess-browser.mjs",
    "test:live-browser": "node scripts/live-chat-browser.mjs",
    "test:privacy-browser": "node scripts/privacy-browser.mjs",
    "sync-content": "node ../scripts/content/sync-content.mjs",
    "validate-skills": "node ../scripts/content/validate-skills.mjs",
    "test:forming-browser": "node scripts/node-forming-browser.mjs",
    "test:media-browser": "node scripts/media-browser.mjs",
    "sync-privacy": "node scripts/sync-privacy.mjs",
    "test:chess-transition-browser": "node scripts/chess-transition-browser.mjs",
    "test:navigation-browser": "node scripts/navigation-browser.mjs",
    "test:mobile": "node scripts/mobile-browser.mjs && node scripts/mobile-webkit.mjs",
    "test:mobile-ui": "node scripts/mobile-ui-browser.mjs",
    "test:chat-glass": "node scripts/chat-glass-browser.mjs",
    "test:chess-cleanup": "node scripts/chess-cleanup-browser.mjs",
    "test:chess-geometry": "node scripts/chess-geometry-browser.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "chess.js": "^1.4.0"
  }
}
