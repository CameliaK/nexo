    {
      "id": "lc-02-format",
      "name": "Format Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [300, 300],
      "parameters": {
        "jsCode": "const body = $('Webhook Trigger').first().json.body;\n// Chess notice: only the game's #tag and the link to the owner panel (never the player's email).\n// Telegram only notifies; moves are made from the web panel.\nif (body.kind === 'chess') {\n  const tag = String(body.tag || '????').slice(0, 4).toUpperCase();\n  const text = '\\u265f #' + tag + ' \\u00b7 abrir partida\\n' + (body.link || '');\n  return [{ json: { text, token: body.telegram_bot_token, chat_id: body.telegram_chat_id } }];\n}\nconst label = (body.visitor_id || '????').slice(0, 4).toUpperCase();\nconst name = body.name || 'visitante';\nconst text = '#' + label + ' \\u00b7 ' + name + '\\n\\n' + body.text;\nreturn [{ json: { text, token: body.telegram_bot_token, chat_id: body.telegram_chat_id } }];"
      }
    },
    {
      "id": "lc-03-telegram",
      "name": "Send Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.telegram.org/bot' + $json.token + '/sendMessage' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { chat_id: $json.chat_id, text: $json.text } }}",
        "options": {}
      }
    },
    {
      "id": "lc-04-respond",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [740, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: $json.ok, telegram_msg_id: $json.result ? $json.result.message_id : null } }}",
        "options": {}
      }
    }
  ],
