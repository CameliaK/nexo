# ── Nexo — variables de entorno ──────────────────────────────────────────────
# Copia este archivo como .env y rellena TODOS los valores antes de levantar
# el stack en producción. Los valores marcados (dev-only) se pueden omitir
# en producción (tienen fallback seguro), pero los demás son OBLIGATORIOS.
#
# Generar claves aleatorias:
#   python3 -c "import secrets; print(secrets.token_hex(32))"

# ── Gateway (Go) ──────────────────────────────────────────────────────────────
# Clave para firmar tokens PASETO v4 local (32 bytes hex = 64 chars).
# Generar: make gen-key
PASETO_LOCAL_KEY=

# ── Agente (Python + FastAPI) ─────────────────────────────────────────────────
# Proveedor de LLM — DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
# Modelo a usar. deepseek-chat es el más barato y suficiente para este caso.
DEEPSEEK_MODEL=deepseek-chat

# ── Chat en vivo — Telegram ───────────────────────────────────────────────────
# Token del bot (@BotFather → /newbot).
TELEGRAM_BOT_TOKEN=
# Chat ID del dueño: reenvía un mensaje al bot y llama a
#   https://api.telegram.org/bot<TOKEN>/getUpdates para obtener el chat_id.
TELEGRAM_CHAT_ID=

# ── Base de datos (Postgres) ──────────────────────────────────────────────────
# Contraseña para el usuario 'nexo' de Postgres.
# En producción usa una cadena aleatoria larga (≥ 24 chars).
POSTGRES_PASSWORD=

# ── n8n ───────────────────────────────────────────────────────────────────────
# Clave de cifrado para credenciales almacenadas en n8n.
# IMPORTANTE: una vez que el stack arranca, este valor NO debe cambiar.
# Si cambia, las credenciales guardadas en n8n quedan ilegibles.
# Generar: python3 -c "import secrets; print(secrets.token_hex(32))"
N8N_ENCRYPTION_KEY=

# Contraseña del usuario owner@nexo.local de la UI de n8n.
# En producción usa una contraseña fuerte (≥ 20 chars, mixta).
# El stack solo la necesita en el PRIMER arranque (cuando crea el usuario).
# Si el volumen n8n_data ya existe con el usuario creado, este valor se ignora.
N8N_OWNER_PASSWORD=

# ── Traefik (solo producción) ─────────────────────────────────────────────────
# Dominio principal del sitio (sin https:// ni ruta).
# Ejemplo: nexo.kirbith.com
DOMAIN=

# Email para las notificaciones de Let's Encrypt (certificado caducando, etc.)
ACME_EMAIL=
