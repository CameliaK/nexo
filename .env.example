# ── Nexo — variables de entorno ──────────────────────────────────────────────
# Copia este archivo como .env y rellena TODOS los valores antes de levantar
# el stack en producción. Los valores marcados (dev-only) se pueden omitir
# en producción (tienen fallback seguro), pero los demás son OBLIGATORIOS.
#
# Generar claves aleatorias:
#   python3 -c "import secrets; print(secrets.token_hex(32))"

# ── Gateway (Go) ──────────────────────────────────────────────────────────────
# Clave para firmar tokens PASETO v4 local (32 bytes hex = 64 chars).
# Generar: make gen-key
PASETO_LOCAL_KEY=

# URL pública del sitio, sin barra final. Se usa en los enlaces de los correos
# (login, baja) y en la redirección tras Google. Dev: http://localhost
PUBLIC_BASE_URL=

# ── Cuentas ──────────────────────────────────────────────────────────────────
# Correo del dueño. Solo es dueño quien entra con este correo y con un
# proveedor de OWNER_PROVIDERS (por defecto solo "google", en docker-compose.yml).
# Vacío = nadie es dueño (falla cerrado).
OWNER_EMAIL=

# ── Ajedrez oculto ───────────────────────────────────────────────────────────
# Opcionales: si se dejan vacíos, docker-compose.yml usa estos valores.
# Partidas activas en total (todas las cuentas) y jugadas del jugador por hora.
CHESS_MAX_ACTIVE=5
CHESS_MOVES_PER_HOUR=30
# Un correo de aviso al jugador por partida cada N horas; un aviso de Telegram
# al dueño por partida cada N minutos.
CHESS_EMAIL_COOLDOWN_HOURS=6
CHESS_NOTIFY_MINUTES=10
# Se borran las partidas sin actividad en N días, y las que siguen sin ninguna
# jugada tras N horas.
CHESS_EXPIRE_DAYS=30
CHESS_EMPTY_EXPIRE_HOURS=48

# ── Retención y borrado de datos ─────────────────────────────────────────────
# Opcionales: si se dejan vacíos, docker-compose.yml usa estos valores.
# Días sin actividad tras los que se borran los nodos generados de un visitante,
# y días tras los que se borra cada mensaje del chat en vivo.
NODES_RETENTION_DAYS=90
LIVE_RETENTION_DAYS=180
# DELETE /api/v1/session/data: borrados por visitante y por IP, por hora.
SESSION_DATA_DELETE_PER_HOUR=5
SESSION_DATA_DELETE_PER_IP_HOUR=20

# ── Correo (SMTP) ─────────────────────────────────────────────────────────────
# En desarrollo no hace falta nada: docker-compose.override.yml envía a mailpit
# (UI en http://localhost:8025). En producción son OBLIGATORIOS para el login
# por enlace (sin SMTP_HOST, /auth/email/request responde 503).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# starttls (TLS obligatorio, nunca cae a texto plano) o ssl (TLS implícito, 465).
# "none" solo existe para mailpit en dev y se rechaza si hay SMTP_USER/SMTP_PASS.
SMTP_TLS=starttls
# Remitente, p. ej.: Nexo <no-reply@tu-dominio.com>
MAIL_FROM=

# ── Google (OIDC) ─────────────────────────────────────────────────────────────
# Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth
# (aplicación web). Redirect autorizado: <PUBLIC_BASE_URL>/auth/google/callback
# Dev: http://localhost/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

# ── Límites de uso (opcionales; los defaults viven en docker-compose.yml) ─────
# Chat con el agente: preguntas por visitante y por IP en una hora, y TTL de
# seguridad de la marca "una consulta activa por visitante" (409 busy).
# CHAT_RATE_PER_HOUR=20
# CHAT_RATE_PER_IP_HOUR=60
# CHAT_ACTIVE_TTL=120s
# Sesiones de invitado (GET /auth/guest) por IP en una hora. El id de visitante
# lo genera el cliente, así que este es el único freno a inventar ids sin parar.
# AUTH_GUEST_PER_IP_HOUR=60
# Tope diario global de llamadas al LLM (cada llamada cuenta, 2–4 por pregunta).
# Al agotarse, el chat responde run.error llm_unavailable sin llamar al proveedor.
# Se reinicia a las 00:00 UTC.
# LLM_DAILY_CALLS=1500
#
# IP del visitante (para los límites por IP; IPv6 se agrupa por /64):
# - El gateway solo confía en X-Forwarded-For si la petición viene de
#   TRUSTED_PROXIES (default: el contenedor "traefik"); si llega directo, lo ignora.
# - En desarrollo con Docker Desktop TODAS las peticiones llegan con la misma IP
#   (la del puente de Docker), así que el límite por IP es compartido.
# - En producción Traefik debe ver la IP real del visitante: DNS de Cloudflare
#   en modo "solo DNS" (sin proxy). Si se activa el proxy de Cloudflare, hay que
#   añadir sus rangos en forwardedHeaders.trustedIPs de Traefik Y en
#   TRUSTED_PROXIES (p. ej. TRUSTED_PROXIES=traefik,173.245.48.0/20,...); si no,
#   todos los visitantes compartirían la IP de Cloudflare.
# TRUSTED_PROXIES=traefik

# ── Agente (Python + FastAPI) ─────────────────────────────────────────────────
# Proveedor de LLM — DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
# Modelo a usar. deepseek-chat es el más barato y suficiente para este caso.
DEEPSEEK_MODEL=deepseek-chat

# ── Chat en vivo — Telegram ───────────────────────────────────────────────────
# Token del bot (@BotFather → /newbot).
TELEGRAM_BOT_TOKEN=
# Chat ID del dueño: reenvía un mensaje al bot y llama a
#   https://api.telegram.org/bot<TOKEN>/getUpdates para obtener el chat_id.
TELEGRAM_CHAT_ID=

# ── Base de datos (Postgres) ──────────────────────────────────────────────────
# Contraseña para el usuario 'nexo' de Postgres.
# En producción usa una cadena aleatoria larga (≥ 24 chars).
POSTGRES_PASSWORD=

# ── n8n ───────────────────────────────────────────────────────────────────────
# Clave de cifrado para credenciales almacenadas en n8n.
# IMPORTANTE: una vez que el stack arranca, este valor NO debe cambiar.
# Si cambia, las credenciales guardadas en n8n quedan ilegibles.
# Generar: python3 -c "import secrets; print(secrets.token_hex(32))"
N8N_ENCRYPTION_KEY=

# Contraseña del usuario owner@nexo.local de la UI de n8n.
# En producción usa una contraseña fuerte (≥ 20 chars, mixta).
# El stack solo la necesita en el PRIMER arranque (cuando crea el usuario).
# Si el volumen n8n_data ya existe con el usuario creado, este valor se ignora.
N8N_OWNER_PASSWORD=

# ── Traefik (solo producción) ─────────────────────────────────────────────────
# Dominio principal del sitio (sin https:// ni ruta).
# Ejemplo: nexo.kirbith.com
DOMAIN=

# Email para las notificaciones de Let's Encrypt (certificado caducando, etc.)
ACME_EMAIL=
