# ── Nexo — variables de entorno de PRODUCCIÓN ────────────────────────────────
# Copia este archivo como .env en el VPS (/opt/nexo/.env, chmod 600) y rellena
# los valores. Se usa con:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml …   (make prod-up)
#
# [obligatoria] docker-compose.prod.yml la exige con ${VAR:?}: si falta,
#               `make prod-config` falla en vez de usar un valor de desarrollo.
# [opcional]    vacía = se usa el valor por defecto indicado.
# Entre corchetes, el servicio que la lee.
#
# Generar secretos: python3 -c "import secrets; print(secrets.token_hex(32))"
# Nunca subas el .env real al repo (está en .gitignore).

# ── Dominio y TLS ────────────────────────────────────────────────────────────
# [obligatoria] [traefik] Dominio sin https:// ni ruta. Se sirve también
# www.DOMAIN, que redirige a DOMAIN. Ejemplo: nexo.kirbith.com
DOMAIN=
# [obligatoria] [traefik] Correo para Let's Encrypt (avisos de caducidad).
ACME_EMAIL=
# [obligatoria] [gateway, agent] URL pública, sin barra final: enlaces de los
# correos (login, baja, aviso de ajedrez), redirección de Google y enlace de
# Telegram al panel. Debe ser https://DOMAIN.
PUBLIC_BASE_URL=

# ── Secretos ─────────────────────────────────────────────────────────────────
# [obligatoria] [gateway] Clave PASETO v4 local, 64 caracteres hex (make gen-key).
# Cambiarla invalida todas las sesiones y los enlaces de baja ya enviados.
PASETO_LOCAL_KEY=
# [obligatoria] [postgres, gateway, agent] Contraseña de Postgres. Solo se
# aplica al crear el volumen; cambiarla después exige ALTER USER.
POSTGRES_PASSWORD=
# [obligatoria] [n8n] Cifra las credenciales guardadas en n8n. No la cambies
# con datos existentes.
N8N_ENCRYPTION_KEY=
# [obligatoria] [n8n] Contraseña de owner@nexo.local en la UI de n8n (≥ 20
# caracteres). Solo se usa al crear el usuario (primer arranque).
N8N_OWNER_PASSWORD=

# ── LLM ──────────────────────────────────────────────────────────────────────
# [obligatoria] [agent] API key de DeepSeek.
DEEPSEEK_API_KEY=
# [opcional] [agent] Modelo. Por defecto: deepseek-chat
DEEPSEEK_MODEL=
# [opcional] [agent] Tope diario global de llamadas al LLM. Por defecto: 1500
LLM_DAILY_CALLS=

# ── Telegram (chat en vivo y avisos de ajedrez) ──────────────────────────────
# [obligatoria] [agent, n8n] Token del bot (BotFather). El agente lo pasa a
# n8n en el cuerpo del webhook (los Code nodes no leen process.env).
TELEGRAM_BOT_TOKEN=
# [obligatoria] [agent, n8n] Chat del dueño que recibe los mensajes.
TELEGRAM_CHAT_ID=

# ── Cuentas ──────────────────────────────────────────────────────────────────
# [opcional] [gateway] Correo del dueño. Vacío = nadie es dueño (falla cerrado).
# El proveedor que concede el modo dueño es "google" (OWNER_PROVIDERS, fijo en
# docker-compose.yml).
OWNER_EMAIL=
# [opcional] [gateway] Login con Google (OIDC). Vacíos = desactivado.
# Redirect autorizado en Google Cloud: https://DOMAIN/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

# ── Correo (SMTP) ────────────────────────────────────────────────────────────
# [opcional] [gateway] Vacío = sin login por correo ni avisos de ajedrez.
SMTP_HOST=
# [opcional] [gateway] Por defecto: 587
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# [opcional] [gateway] starttls (por defecto, TLS obligatorio) o ssl. "none"
# solo existe para mailpit en desarrollo.
SMTP_TLS=
# [gateway] Remitente; obligatorio si hay SMTP_HOST. Ej.: Nexo <no-reply@DOMAIN>
MAIL_FROM=

# ── Proxy e IP real ──────────────────────────────────────────────────────────
# [opcional] [gateway] Solo se confía en X-Forwarded-For si la petición llega
# de estos (nombres o CIDR). Por defecto: traefik. Si pones Cloudflare con
# proxy delante, agrega sus rangos aquí y en Traefik (forwardedHeaders).
TRUSTED_PROXIES=

# ── Límites de uso ───────────────────────────────────────────────────────────
# [opcional] [gateway] Valores por defecto entre paréntesis.
# /auth/guest por IP y hora (60)
AUTH_GUEST_PER_IP_HOUR=
# preguntas al agente por visitante y hora (20)
CHAT_RATE_PER_HOUR=
# preguntas al agente por IP y hora (60)
CHAT_RATE_PER_IP_HOUR=
# vida máxima de la marca de consulta activa (120s)
CHAT_ACTIVE_TTL=
# DELETE /api/v1/session/data por visitante (5)
SESSION_DATA_DELETE_PER_HOUR=
# DELETE /api/v1/session/data por IP (20)
SESSION_DATA_DELETE_PER_IP_HOUR=
# jugadas del jugador por cuenta y hora (30)
CHESS_MOVES_PER_HOUR=
# un correo de aviso por partida cada N horas (6)
CHESS_EMAIL_COOLDOWN_HOURS=
# [opcional] [agent]
# partidas activas en total (5)
CHESS_MAX_ACTIVE=
# un aviso de Telegram por partida cada N min (10)
CHESS_NOTIFY_MINUTES=

# ── Retención ────────────────────────────────────────────────────────────────
# [opcional] [agent] Valores por defecto entre paréntesis.
# nodos generados sin actividad (90)
NODES_RETENTION_DAYS=
# mensajes del chat en vivo (180)
LIVE_RETENTION_DAYS=
# partidas sin actividad (30)
CHESS_EXPIRE_DAYS=
# partidas sin ninguna jugada (48)
CHESS_EMPTY_EXPIRE_HOURS=

# ── Umbrales del agente ──────────────────────────────────────────────────────
# [opcional] [agent] No los bajes "para probar" (ver CLAUDE.md).
# (0.75)
RAG_SIMILARITY_THRESHOLD=
# (0.7)
ROUTE_CONFIDENCE_THRESHOLD=

# ── Respaldos (scripts/backup.sh, no lo lee ningún contenedor) ───────────────
# Se pasan en la línea de cron, no aquí: ver docs/despliegue.md §11.
#   COMPOSE_FILES="-f docker-compose.yml -f docker-compose.prod.yml"
#   BACKUP_DIR=/opt/nexo/backups
